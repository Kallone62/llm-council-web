# Amiable native configuration used by this Karpathy UI integration.
# Copy this to ./llm_council.yaml if you want to restore the app defaults.
# The Settings screen edits the same fields directly.

tiers:
  default: high                    # quick | balanced | high | reasoning

council:
  # Leave this list aligned with the selected profile, or choose exact
  # OpenRouter model IDs from Settings.
  models:
    - openai/gpt-5.6-sol
    - anthropic/claude-opus-5
    - deepseek/deepseek-v4-pro-0813
    - z-ai/glm-5.3

  # chairman: openai/gpt-5.6-sol   # omit for Amiable Auto/profile chairman
  synthesis_mode: consensus        # consensus | debate
  exclude_self_votes: true
  style_normalization: false       # false | true | auto
  # max_reviewers: 3               # omit to use all available reviewers

evaluation:
  rubric:
    enabled: false
  safety:
    enabled: false
  bias:
    audit_enabled: false
    persistence_enabled: false

cache:
  enabled: false
  ttl_seconds: 0                    # 0 = no expiry

timeouts:
  multiplier: 1.0                  # UI applies this to Stage 2/3 budget

# Other Amiable sections may be added manually. The Settings UI preserves
# unrelated sections when it saves its managed fields.
