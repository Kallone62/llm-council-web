# OpenRouter is required to run council requests.
# You can leave this blank and add/change the key later from Settings in the UI.
OPENROUTER_API_KEY=

# Optional: store Karpathy UI conversations somewhere else.
# LLM_COUNCIL_UI_DATA_DIR=data/conversations

# Advanced users may point the app at a different Amiable YAML file.
# If omitted, the bundled ./llm_council.yaml is used and managed by Settings.
# LLM_COUNCIL_CONFIG=C:/path/to/llm_council.yaml
